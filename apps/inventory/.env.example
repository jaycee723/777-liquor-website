# GEMINI_API_KEY: Required for server-side Gemini AI API calls (Enrichment in Phase 3).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# 777 Inventory API Client Switch
# Set VITE_USE_MOCK_API="false" and point VITE_API_BASE_URL to your Cloudflare Worker when deploying live.
VITE_USE_MOCK_API="true"
VITE_API_BASE_URL="https://inventory.777liquor.com"

# Clover REST API v3 Credentials (Server-side only — never prefix with VITE_)
# Add these in AI Studio Settings -> Secrets or your server environment.
CLOVER_MERCHANT_ID=
CLOVER_API_TOKEN=
CLOVER_API_BASE_URL=https://api.clover.com
