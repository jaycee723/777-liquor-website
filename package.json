{
  "name": "777-liquor-website-cloudflare",
  "private": true,
  "workspaces": [
    "777-Liquor-Website/website",
    "777-Liquor-Website/website/packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix 777-Liquor-Website/website run dev",
    "build": "npm --prefix 777-Liquor-Website/website run build",
    "lint": "npm --prefix 777-Liquor-Website/website run lint",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.135.0"
  },
  "dependencies": {
    "lucide-react": "^1.77.0",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "vite": "^7.3.1"
  }
}
